# ============================================================
# ruijie-auto-login Shell 版本配置文件
#
# 用法：
#   cp shell/config.sh.example shell/config.sh
#   然后修改下面的账号列表
#
# 说明：
#   - Shell 版本不复用 Go 版本的 config.json（避免依赖 jq）
#   - 账号格式：每行一个 "账号|密码"
#   - 密码可以包含空格和常见特殊字符，但不要把 | 用在账号或密码中
#   - 不要使用 eval，配置由 autologin.sh 安全解析
# ============================================================

# 锐捷 ePortal 地址
PORTAL_BASE="http://172.16.32.240"

# 参数探测地址（锐捷网关会拦截并返回真正的登录 URL）
PROBE_URL="http://119.29.29.29/"

# 监控模式下检测在线状态的间隔（秒）
CHECK_INTERVAL=10

# 所有账号登录失败后的重试等待时间（秒）
RETRY_INTERVAL=5

# 每个 HTTP 请求的超时时间（秒）
REQUEST_TIMEOUT=10

# 账号列表：每行一个 "账号|密码"
# 程序启动时会随机选择一个账号作为起点，之后按顺序轮询
ACCOUNTS="
账号A|密码A
账号B|密码B
账号C|密码C
"
